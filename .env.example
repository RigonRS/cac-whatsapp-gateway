# ============================================================
# Copie este arquivo para ".env" e preencha os valores.
# ============================================================

# Domínio (subdomínio) onde o gateway vai responder, com HTTPS.
DOMAIN=wa.prbelico.com.br

# Origem do CAC Gestão (pode ter mais de uma, separadas por vírgula).
FRONT_ORIGIN=https://gestao.prbelico.com.br,https://rigonrs.github.io

# --- Azure AD / Microsoft (os mesmos do worker do portal) ---
AZURE_TENANT_ID=be520b86-b5ad-44dd-acd2-b6a56d438ca5
AZURE_CLIENT_ID=b9e4b955-b4e0-498c-b1c1-e996cc91dcf0
AZURE_CLIENT_SECRET=COLE_AQUI_O_SEGREDO_DO_APP

# OneDrive de dados (onde ficam os JSON, ex.: clientes.json)
ONEDRIVE_UPN=matheus@simonebpegoraro.onmicrosoft.com

# Porta interna do servidor (o Caddy fala com ela; não precisa mudar)
PORT=3000

# Nível de log (warn | info | debug)
LOG_LEVEL=warn
